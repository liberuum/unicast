#!/usr/bin/env bash
# Remove everything omarchy-cast put on this machine outside the plugin folder:
# the daemon binary, its systemd user unit, build cache, runtime state, and the
# per-receiver ufw rules it added (each removal is authorized through polkit).
# A file at one of those paths that UniCast did not create is left in place.
#
#   omarchy-cast-uninstall           keep ~/.config/omarchy/cast (settings)
#   omarchy-cast-uninstall --purge   delete the settings too
#
# Afterwards remove the widget itself with:
#   omarchy plugin remove universal-cast
set -uo pipefail

PURGE=0
KEEP_LEDGER=0
for arg in "$@"; do
  case $arg in
    --purge) PURGE=1 ;;
    -h|--help) sed -n '2,/^set /p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "omarchy-cast-uninstall: unknown option $arg" >&2; exit 2 ;;
  esac
done

HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Paths, the ownership record, sha(), bin_is_ours() and unit_is_ours().
. "$HERE/lib/ownership.sh"
RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/universal-cast

say() { printf '\033[1momarchy-cast:\033[0m %s\n' "$*"; }

# Decide ownership before anything is removed: the binary check can rely on
# the build cache, which goes below.
OURS_BIN=0; bin_is_ours && OURS_BIN=1
OURS_UNIT=0; unit_is_ours && OURS_UNIT=1
OURS_CACHE=0; [[ -d $CACHE && ! -L $CACHE && -f $CACHE_MARKER ]] && OURS_CACHE=1

# 1. Firewall rules: ask the daemon to delete the rules it recorded. Only the
# binary setup installed is run, never whatever else sits at that path, and
# with --no-start it only talks to a daemon that is already running: it never
# installs, enables or spawns one.
if [[ -s $CONFIG/firewall-rules ]]; then
  if (( OURS_BIN )); then
    say "removing the ufw rules the daemon added (polkit will ask)"
    "$BIN" --client --no-start clear-firewall >/dev/null 2>&1 || true
  fi
  if [[ -s $CONFIG/firewall-rules ]]; then
    say "these ufw rules were not removed; delete them with sudo ufw delete, or list them with: sudo ufw status | grep universal-cast"
    sed 's/^/    /' "$CONFIG/firewall-rules"
    # Keep the record even with --purge, so a later run can still remove them.
    KEEP_LEDGER=1
  fi
fi

# 2. Daemon and unit. The binary goes first: a status poll from the still
# loaded widget would otherwise respawn the daemon and rewrite the unit file
# between the stop and the removal below.
if (( OURS_BIN )); then
  rm -f -- "$BIN" "$OWNED"
  say "removed $BIN"
elif [[ -e $BIN || -L $BIN ]]; then
  say "kept $BIN: it is not the binary the setup script installed"
fi
if (( OURS_CACHE )); then
  rm -rf -- "$CACHE"
  say "removed $CACHE"
elif [[ -e $CACHE || -L $CACHE ]]; then
  say "kept $CACHE: it was not created by the setup script"
fi
if (( OURS_UNIT )); then
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
  rm -f -- "$UNIT_FILE"
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  say "stopped and removed $UNIT"
elif [[ -e $UNIT_FILE || -L $UNIT_FILE ]]; then
  say "kept $UNIT_FILE: it was not written by UniCast"
fi
# A daemon started outside systemd (the client's fallback) survives the unit
# stop. Signal only processes of this user whose executable is the binary
# removed above, never anything that merely shares the name.
if (( OURS_BIN )); then
  for pid in $(pgrep -u "$(id -u)" -x omarchy-castd 2>/dev/null); do
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
    if [[ $exe == "$BIN" || $exe == "$BIN (deleted)" ]]; then
      kill "$pid" 2>/dev/null || true
    fi
  done
fi

# 3. Runtime state: only the entries the daemon creates, then the folder if
# that left it empty.
if [[ -d $RUNTIME && ! -L $RUNTIME ]]; then
  rm -f -- "$RUNTIME/castd.sock" "$RUNTIME/castd.lock"
  rm -rf -- "$RUNTIME/subtitles"
  rmdir -- "$RUNTIME" 2>/dev/null || true
  say "removed runtime state"
fi

# 4. Settings only on request, and only the files the daemon writes.
if (( PURGE )) && [[ -d $CONFIG && ! -L $CONFIG ]]; then
  rm -f -- "$CONFIG/settings.json" "$CONFIG/manual-ips" "$CONFIG"/*.tmp.* "$OWNED" "$OWNED.tmp"
  if (( KEEP_LEDGER )); then
    say "removed settings in $CONFIG except firewall-rules (rules above still exist)"
  else
    rm -f -- "$CONFIG/firewall-rules"
    rmdir -- "$CONFIG" 2>/dev/null || say "kept other files in $CONFIG that UniCast did not write"
    say "removed settings in $CONFIG"
  fi
else
  say "kept settings in $CONFIG (use --purge to delete them)"
fi

say "now remove the widget: omarchy plugin remove universal-cast"
