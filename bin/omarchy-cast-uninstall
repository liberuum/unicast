#!/usr/bin/env bash
# Remove everything omarchy-cast put on this machine outside the plugin folder:
# the daemon binary, its systemd user unit, build cache, runtime state, and the
# per-receiver ufw rules it added (each removal is authorized through polkit).
#
#   omarchy-cast-uninstall           keep ~/.config/omarchy/cast (settings)
#   omarchy-cast-uninstall --purge   delete the settings too
#
# Afterwards remove the widget itself with:
#   omarchy plugin remove universal-cast
set -uo pipefail

PURGE=0
KEEP_LEDGER=0
for arg in "$@"; do
  case $arg in
    --purge) PURGE=1 ;;
    -h|--help) sed -n '2,/^set /p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "omarchy-cast-uninstall: unknown option $arg" >&2; exit 2 ;;
  esac
done

UNIT=omarchy-castd.service
BIN=$HOME/.local/bin/omarchy-castd
CONFIG=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/cast
UNIT_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-cast
RUNTIME=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/universal-cast

say() { printf '\033[1momarchy-cast:\033[0m %s\n' "$*"; }

# 1. Firewall rules: ask the daemon to delete the rules it recorded.
if [[ -s $CONFIG/firewall-rules ]]; then
  if [[ -x $BIN ]]; then
    say "removing the ufw rules the daemon added (polkit will ask)"
    "$BIN" --client clear-firewall >/dev/null 2>&1 || true
  fi
  if [[ -s $CONFIG/firewall-rules ]]; then
    say "these ufw rules were not removed; delete them with sudo ufw delete, or list them with: sudo ufw status | grep universal-cast"
    sed 's/^/    /' "$CONFIG/firewall-rules"
    # Keep the record even with --purge, so a later run can still remove them.
    KEEP_LEDGER=1
  fi
fi

# 2. Daemon and unit. The binaries go first (the installed one and the build
# cache that bin/omarchy-cast falls back to): a status poll from the still
# loaded widget would otherwise respawn the daemon and rewrite the unit file
# between the stop and the removal below.
rm -f "$BIN"
rm -rf "$CACHE"
if systemctl --user list-unit-files "$UNIT" >/dev/null 2>&1; then
  systemctl --user disable --now "$UNIT" >/dev/null 2>&1 || true
fi
rm -f "$UNIT_FILE"
systemctl --user daemon-reload >/dev/null 2>&1 || true
# A daemon started outside systemd (the client's fallback) survives the unit
# stop. Signal only processes of this user whose executable is the binary
# removed above, never anything that merely shares the name.
for pid in $(pgrep -u "$(id -u)" -x omarchy-castd 2>/dev/null); do
  exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || continue
  if [[ $exe == "$BIN" || $exe == "$BIN (deleted)" ]]; then
    kill "$pid" 2>/dev/null || true
  fi
done
say "stopped and removed $UNIT"

# 3. Runtime state.
rm -rf "$RUNTIME"
say "removed $BIN, $CACHE and runtime state"

# 4. Settings only on request.
if (( PURGE )) && (( KEEP_LEDGER )); then
  find "$CONFIG" -mindepth 1 -maxdepth 1 ! -name firewall-rules -exec rm -rf -- {} +
  say "removed settings in $CONFIG except firewall-rules (rules above still exist)"
elif (( PURGE )); then
  rm -rf "$CONFIG"
  say "removed settings in $CONFIG"
else
  say "kept settings in $CONFIG (use --purge to delete them)"
fi

say "now remove the widget: omarchy plugin remove universal-cast"
