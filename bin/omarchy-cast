#!/bin/sh
# Thin client for the omarchy-castd daemon.
#
# Forwards the QML panel's argv verbs (status/discover/connect/disconnect/
# pause/resume/...) to the persistent daemon over its unix socket. Only the
# binary bin/omarchy-cast-setup installs (~/.local/bin) or a distro package
# (/usr/bin) is ever run: never one found on PATH or inside the plugin folder.
for bin in "$HOME/.local/bin/omarchy-castd" /usr/bin/omarchy-castd; do
  if [ -x "$bin" ]; then
    exec "$bin" --client "$@"
  fi
done
printf '%s\n' '{"ok": false, "error": "omarchy-castd is not installed yet."}'
